{
    "name": "mb4it/filament-chatbot",
    "description": "Customer chat and a visual chatbot builder for any Filament panel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "chat",
        "chatbot",
        "live chat",
        "workflow",
        "conversation"
    ],
    "authors": [
        {
            "name": "Maxim Bezvodinskikh",
            "email": "m.bezvodinskikh@gmail.com",
            "homepage": "https://mb4it.ru"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "laravel/ai": "Enables the laravel-ai gateway driver for Anthropic, Gemini, Bedrock and tool calling (^0.11)"
    },
    "autoload": {
        "psr-4": {
            "MB\\FilamentChatbot\\": "src/",
            "MB\\FilamentChatbot\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MB\\FilamentChatbot\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/pest",
        "lint": "@php vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MB\\FilamentChatbot\\ChatbotServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
